
.program pwm
.side_set 1 opt

.wrap_target
    pull noblock
    mov x, osr

bits:
    out y, 1

    jmp y-- on
    jmp off         side 0
on:
    nop             side 1
off:
    jmp !osre bits
.wrap

% c-sdk {
#ifndef _HARDWARE_CLOCKS_H_
#include "hardware/clocks.h"
#endif
#ifndef _HARDWARE_STRUCTS_CLOCKS_H
#include "hardware/structs/clocks.h"
#endif

#define INSTRUCTIONS_PER_LOOP 771

static inline void pwm_program_init(PIO pio, uint sm, uint offset, uint pin, uint freq) {
   pio_gpio_init(pio, pin);
   pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
   pio_sm_config c = pwm_program_get_default_config(offset);
   sm_config_set_sideset_pins(&c, pin);
   uint32_t f_clk_sys = frequency_count_khz(CLOCKS_FC0_SRC_VALUE_CLK_SYS);
   float clk_divider = (float)f_clk_sys / (INSTRUCTIONS_PER_LOOP * (freq / KHZ));
   sm_config_set_clkdiv(&c, clk_divider);
   pio_sm_init(pio, sm, offset, &c);
   pio_sm_set_enabled(pio, sm, true);
}
%}